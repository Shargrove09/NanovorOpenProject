<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/nanolog/nanolog.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/nanolog/nanolog.xsd"
           elementFormDefault="qualified">

    <xs:element name="nanolog">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="entries" type="tns:entriesType" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="entriesType">
        <xs:sequence>
            <xs:element name="entry" type="tns:entryType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="entryType">
        <xs:sequence>
            <xs:element name="id" type="xs:integer"/>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="content" type="xs:string"/>
            <xs:element name="date" type="xs:string"/>
            <xs:element name="type" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>