<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/collections/collections.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/collections/collections.xsd"
           elementFormDefault="qualified">

    <xs:element name="collections">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="virmonList">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="virmon" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="id" type="xs:string"/>
                                        <xs:element name="name" type="xs:string"/>
                                        <xs:element name="assetTypeId" type="xs:string"/>
                                        <xs:element name="assetId" type="xs:string"/>
                                        <xs:element name="faction" type="xs:string"/>
                                        <xs:element name="rarity" type="xs:string"/>
                                        <xs:element name="wave" type="xs:string"/>
                                        <xs:element name="base-health" type="xs:string"/>
                                        <xs:element name="base-armor" type="xs:string"/>
                                        <xs:element name="base-speed" type="xs:string"/>
                                        <xs:element name="base-strength" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="emList">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="em" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="id" type="xs:string"/>
                                        <xs:element name="name" type="xs:string"/>
                                        <xs:element name="assetTypeId" type="xs:string"/>
                                        <xs:element name="assetId" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>