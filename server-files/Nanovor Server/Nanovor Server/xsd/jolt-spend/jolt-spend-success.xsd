<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/jolt-spend/jolt-spend-success.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/jolt-spend/jolt-spend-success.xsd"
           elementFormDefault="qualified">

    <xs:element name="jolt-spend-success">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="updated-stats" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="health" type="xs:int"/>
                            <xs:element name="armor" type="xs:int"/>
                            <xs:element name="strength" type="xs:int"/>
                            <xs:element name="speed" type="xs:int"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>