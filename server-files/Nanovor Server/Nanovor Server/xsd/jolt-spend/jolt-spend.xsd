<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/jolt-spend/jolt-spend.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/jolt-spend/jolt-spend.xsd"
           elementFormDefault="qualified">

    <xs:element name="jolt-spend">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="armor-delta" type="xs:int"/>
                <xs:element name="health-delta" type="xs:int"/>
                <xs:element name="speed-delta" type="xs:int"/>
                <xs:element name="strength-delta" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>