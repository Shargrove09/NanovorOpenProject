<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/evolution/evolution-success.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/evolution/evolution-success.xsd"
           elementFormDefault="qualified">

    <xs:element name="evolution-success">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="evolved-virmon-id" type="xs:string" minOccurs="0"/>
                <xs:element name="new-evolution-level" type="xs:int" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>