<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/evolution/evolution.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/evolution/evolution.xsd"
           elementFormDefault="qualified">

    <xs:element name="evolution">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="evolution-id" type="xs:string"/>
                <xs:element name="original-virmon-id" type="xs:string" minOccurs="0"/>
                <xs:element name="new-virmon-id" type="xs:string" minOccurs="0"/>
                <xs:element name="status" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>