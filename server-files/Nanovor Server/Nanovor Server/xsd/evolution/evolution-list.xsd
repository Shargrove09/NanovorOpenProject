<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/evolution/evolution-list.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/evolution/evolution-list.xsd"
           elementFormDefault="qualified">

    <xs:element name="evolution-list">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="evolution" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="xs:string"/>
                            <xs:element name="name" type="xs:string"/>
                            <xs:element name="requirements" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="em-required" type="xs:string"/>
                                        <xs:element name="nanocash-required" type="xs:int"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>