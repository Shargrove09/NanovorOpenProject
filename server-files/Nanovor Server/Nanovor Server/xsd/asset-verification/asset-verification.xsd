<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/asset-verification/asset-verification.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/asset-verification/asset-verification.xsd"
           elementFormDefault="qualified">

    <xs:element name="asset-verification">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="verified" type="xs:boolean"/>
                <xs:element name="asset-id" type="xs:string" minOccurs="0"/>
                <xs:element name="signature" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>