<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/asset-list/asset-list.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/asset-list/asset-list.xsd"
           xmlns:ns2="http://127.0.0.1:8443/xsd/asset-miscellany/asset-miscellany.xsd"
           xmlns:ns3="http://127.0.0.1:8443/xsd/asset-stat/asset-stat.xsd"
           elementFormDefault="qualified">

    <xs:import namespace="http://127.0.0.1:8443/xsd/asset-miscellany/asset-miscellany.xsd" schemaLocation="../asset-miscellany/asset-miscellany.xsd"/>
    <xs:import namespace="http://127.0.0.1:8443/xsd/asset-stat/asset-stat.xsd" schemaLocation="../asset-stat/asset-stat.xsd"/>

    <xs:element name="asset-list">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="assets" type="tns:assetsType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="assetsType">
        <xs:sequence>
            <xs:element name="asset" type="tns:assetType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="assetType">
        <xs:sequence>
            <xs:element name="asset-type-category" type="xs:string"/>
            <xs:element name="asset-type-id" type="xs:integer"/>
            <xs:element name="asset-type-name" type="xs:string"/>
            <xs:element name="production-number" type="xs:integer"/>
            <xs:element name="birth-date" type="xs:string"/>
            <xs:element name="last-evolution-date" type="xs:string"/>
            <xs:element ref="ns2:asset-miscellany" minOccurs="0"/>
            <xs:element ref="ns3:asset-stat" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
</xs:schema>