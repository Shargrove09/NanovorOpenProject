<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/asset/asset-miscellany.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/asset/asset-miscellany.xsd"
           elementFormDefault="qualified">

    <xs:element name="asset-miscellany">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nickname" type="xs:string" minOccurs="0"/>
                <xs:element name="custom-data" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>