<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/account-statistics.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/account-statistics.xsd"
           elementFormDefault="qualified">

    <xs:element name="account-statistics">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="virmon-master-rating" type="xs:int"/>
                <xs:element name="kill-count" type="xs:int"/>
                <xs:element name="game-count" type="xs:int"/>
                <xs:element name="win-count" type="xs:int"/>
                <xs:element name="two-player-game-count" type="xs:int"/>
                <xs:element name="three-player-game-count" type="xs:int"/>
                <xs:element name="four-player-game-count" type="xs:int"/>
                <xs:element name="hexite-kill-count" type="xs:int"/>
                <xs:element name="magnamod-kill-count" type="xs:int"/>
                <xs:element name="velocitron-kill-count" type="xs:int"/>
                <xs:element name="nanovor-count" type="xs:int"/>
                <xs:element name="unique-nanovor-count" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>