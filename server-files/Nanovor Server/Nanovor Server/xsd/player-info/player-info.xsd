<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/player-info/player-info.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/player-info/player-info.xsd"
           elementFormDefault="qualified">

    <xs:element name="player-info">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="account-id" type="xs:string"/>
                <xs:element name="username" type="xs:string"/>
                <xs:element name="avatar-id" type="xs:int"/>
                <xs:element name="nmp" type="xs:int"/>
                <xs:element name="status" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>