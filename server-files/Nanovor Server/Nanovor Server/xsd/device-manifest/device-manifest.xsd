<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://127.0.0.1:8443/xsd/device-manifest/device-manifest.xsd"
           xmlns:tns="http://127.0.0.1:8443/xsd/device-manifest/device-manifest.xsd"
           elementFormDefault="qualified">

    <xs:element name="device-manifest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="version">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="major" type="xs:int"/>
                            <xs:element name="minor" type="xs:int"/>
                            <xs:element name="build" type="xs:int"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="devices">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="device" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="id" type="xs:string"/>
                                        <xs:element name="name" type="xs:string"/>
                                        <xs:element name="capabilities" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="capability" type="xs:string" maxOccurs="unbounded"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>